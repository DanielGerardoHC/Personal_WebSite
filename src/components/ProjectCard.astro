---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const hasMultipleImages = project.images.length > 1;
---

<article class={`project-card card animate-on-scroll animate-delay-${(index % 3) + 1}`} data-project-id={project.id}>
  <!-- Image Gallery -->
  <div class="project-gallery">
    <div class="gallery-viewport" data-gallery={project.id}>
      {project.images.map((img, i) => (
        <img
          src={img}
          alt={`${project.title} — captura ${i + 1}`}
          class={`gallery-image ${i === 0 ? "active" : ""}`}
          data-index={i}
          loading="lazy"
        />
      ))}
    </div>

    {hasMultipleImages && (
      <div class="gallery-controls">
        <button class="gallery-btn gallery-prev" data-gallery-btn={`${project.id}-prev`} aria-label="Anterior">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <div class="gallery-dots" data-gallery-dots={project.id}>
          {project.images.map((_, i) => (
            <button
              class={`gallery-dot ${i === 0 ? "active" : ""}`}
              data-dot-index={i}
              aria-label={`Imagen ${i + 1}`}
            ></button>
          ))}
        </div>
        <button class="gallery-btn gallery-next" data-gallery-btn={`${project.id}-next`} aria-label="Siguiente">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    )}

    <!-- Lightbox trigger -->
    <button class="gallery-expand" data-lightbox-trigger={project.id} aria-label="Ver imagen completa">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="m21 3-7 7"/><path d="m3 21 7-7"/></svg>
    </button>

    {project.images.length > 1 && (
      <span class="gallery-counter">
        <span data-current-slide={project.id}>1</span> / {project.images.length}
      </span>
    )}
  </div>

  <!-- Content -->
  <div class="project-content">
    <div class="project-tags">
      {project.tags.map((tag) => (
        <span class="chip">{tag}</span>
      ))}
    </div>

    <h3 class="project-title">{project.title}</h3>
    <p class="project-description">{project.longDescription || project.description}</p>

    <!-- Video embed -->
    {project.videoUrl && (
      <div class="project-video">
        <iframe
          src={project.videoUrl}
          title={`Video de ${project.title}`}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    )}

    <!-- Action buttons -->
    <div class="project-actions">
      {project.repoUrl && (
        <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          Repositorio
        </a>
      )}
      {project.docsUrl && (
        <a href={project.docsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
          Documentación
        </a>
      )}
      {project.liveUrl && (
        <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
          Ver en vivo
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
  }

  /* --- Gallery --- */
  .project-gallery {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--sand);
  }

  .gallery-viewport {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .gallery-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--transition-base);
    cursor: pointer;
  }

  .gallery-image.active {
    opacity: 1;
  }

  .gallery-controls {
    position: absolute;
    bottom: var(--space-md);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    background: rgba(26, 26, 26, 0.65);
    backdrop-filter: blur(8px);
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius-full);
  }

  .gallery-btn {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: white;
    transition: background var(--transition-fast);
    cursor: pointer;
  }

  .gallery-btn:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .gallery-dots {
    display: flex;
    gap: 4px;
  }

  .gallery-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    transition: all var(--transition-fast);
    cursor: pointer;
  }

  .gallery-dot.active {
    background: white;
    width: 18px;
    border-radius: 3px;
  }

  .gallery-expand {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(26, 26, 26, 0.5);
    backdrop-filter: blur(8px);
    border-radius: var(--radius-md);
    color: white;
    opacity: 0;
    transition: all var(--transition-fast);
    cursor: pointer;
  }

  .project-gallery:hover .gallery-expand {
    opacity: 1;
  }

  .gallery-expand:hover {
    background: rgba(26, 26, 26, 0.7);
  }

  .gallery-counter {
    position: absolute;
    top: var(--space-md);
    left: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: white;
    background: rgba(26, 26, 26, 0.5);
    backdrop-filter: blur(8px);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
  }

  /* --- Content --- */
  .project-content {
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    flex: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .project-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--ink);
  }

  .project-description {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--stone);
    flex: 1;
  }

  /* --- Video --- */
  .project-video {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--sand-dark);
    margin-top: var(--space-sm);
  }

  .project-video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* --- Actions --- */
  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid var(--sand);
    margin-top: auto;
  }
</style>
