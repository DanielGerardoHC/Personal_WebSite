---
const qualities = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>`,
    title: "Auditor Interno ISO/IEC 27001:2022",
    description: "Certificado internacionalmente por Applus+ Certification. Implementación, gestión y auditoría de Sistemas de Gestión de Seguridad de la Información (SGSI).",
    color: "var(--moss)",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>`,
    title: "Formación",
    description: "Ingeniería en Desarrollo de Software en ITCA-FEPADE (5.º año) y Técnico Superior en Ciberseguridad en la Escuela Superior de Innovación y Tecnología.",
    color: "var(--terracotta)",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
    title: "Gobierno y buenas prácticas de TI",
    description: "Conocimiento y experiencia en marcos de seguridad y gobierno de TI como COBIT y NIST, aplicados en equipos multidisciplinarios y metodologías ágiles.",
    color: "var(--clay)",
  },
];
---

<section class="about section" id="about">
  <div class="container">
    <div class="section-header animate-on-scroll">
      <span class="section-label">Sobre mí</span>
      <h2 class="section-title">Seguridad por diseño, de la infraestructura al código</h2>
      <hr class="divider-short" />
      <p class="section-description about-intro">
        Programador Full Stack con experiencia en el despliegue, administración y
        mantenimiento de infraestructura tecnológica en centros de datos locales y
        entornos cloud, así como en la gestión de ciberseguridad. Certificado
        internacionalmente como Auditor Interno en ISO/IEC 27001:2022 por Applus+
        Certification, con experiencia en la implementación, gestión y auditoría de
        Sistemas de Gestión de Seguridad de la Información (SGSI). Con conocimientos y
        experiencia en marcos y buenas prácticas de seguridad y gobierno de TI,
        incluyendo COBIT y NIST.
      </p>
    </div>

    <div class="about-grid">
      {qualities.map((q, i) => (
        <div class={`about-card animate-on-scroll animate-delay-${i + 1}`}>
          <div class="about-card-icon" style={`color: ${q.color}`}>
            <Fragment set:html={q.icon} />
          </div>
          <h3 class="about-card-title">{q.title}</h3>
          <p class="about-card-desc">{q.description}</p>
          <div class="about-card-accent" style={`background: ${q.color}`}></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about-intro {
    margin-top: var(--space-lg);
    max-width: 72ch;
    font-size: 1rem;
    line-height: 1.75;
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  .about-card {
    position: relative;
    padding: var(--space-xl);
    background: white;
    border-radius: var(--radius-lg);
    border: 1px solid var(--sand-dark);
    overflow: hidden;
    transition: all var(--transition-base);
  }

  .about-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: var(--clay-light);
  }

  .about-card-icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--sand);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-lg);
    transition: transform var(--transition-base);
  }

  .about-card:hover .about-card-icon {
    transform: scale(1.08);
  }

  .about-card-title {
    font-size: 1.2rem;
    margin-bottom: var(--space-sm);
    color: var(--ink);
  }

  .about-card-desc {
    font-size: 0.92rem;
    color: var(--stone);
    line-height: 1.65;
  }

  .about-card-accent {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .about-card:hover .about-card-accent {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
