---
import { projects } from "../data/projects";

const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/gerardo-calderon-10b7492b8/",
  },
  { label: "GitHub", href: "https://github.com/DanielGerardoHC" },
  { label: "LeetCode", href: "https://leetcode.com/u/DgerardoHC/" },
];
---

<footer class="footer" id="footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand -->
      <div class="footer-brand">
        <a href="#" class="footer-logo">
          <span class="brand-dot"></span>
          Daniel<span class="brand-accent">Hernandez</span>
        </a>
        <p class="footer-tagline">
          Senior Cybersecurity Engineer y Full Stack Developer. Auditor Interno
          ISO/IEC 27001:2022, enfocado en proteger infraestructura crítica y
          construir software seguro.
        </p>
      </div>

      <!-- Navigation -->
      <div class="footer-col">
        <h4 class="footer-heading">Navegación</h4>
        <ul class="footer-links">
          <li><a href="#about">Sobre mí</a></li>
          <li><a href="#experience">Experiencia</a></li>
          <li><a href="#projects">Proyectos</a></li>
        </ul>
      </div>

      <!-- Links -->
      <div class="footer-col">
        <h4 class="footer-heading">Links</h4>
        <ul class="footer-links">
          {
            socialLinks.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Projects -->
      <div class="footer-col">
        <h4 class="footer-heading">Proyectos</h4>
        <ul class="footer-links">
          {
            projects.map((p) => (
              <li>
                <a
                  href={p.liveUrl || p.repoUrl || "#"}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {p.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <hr class="divider" />

    <div class="footer-bottom">
      <p class="footer-copy">© {currentYear} Daniel Hernandez.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.7);
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .footer-logo {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 700;
    color: white;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--space-md);
  }

  .brand-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--terracotta);
    display: inline-block;
  }

  .brand-accent {
    color: var(--terracotta);
  }

  .footer-tagline {
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.45);
    max-width: 30ch;
  }

  .footer-heading {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    color: white;
    margin-bottom: var(--space-lg);
    letter-spacing: 0.02em;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-links a {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--clay-light);
  }

  .footer .divider {
    background: rgba(255, 255, 255, 0.08);
    margin-bottom: var(--space-lg);
  }

  .footer-bottom {
    text-align: center;
  }

  .footer-copy {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.3);
  }

  .heart {
    color: var(--terracotta);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
