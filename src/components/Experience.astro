---
interface ExperienceItem {
  period: string;
  role: string;
  company: string;
  location: string;
  summary: string;
  highlights: string[];
  techTags: string[];
  icon: string;
}

const experiences: ExperienceItem[] = [
  {
    period: "Siemens El Salvador",
    role: "Técnico en Automatización Industrial",
    company: "Siemens",
    location: "El Salvador",
    summary:
      "Integración directa en líneas de producción y proyectos de automatización de alto impacto, ejecutando desde ensamblaje estructural hasta puesta en marcha en campo para clientes industriales de la región centroamericana.",
    highlights: [
      "Ensamblaje estructural y eléctrico de tableros de control y distribución de 2,000 a 5,000 A en baja tensión y transferencias de media tensión",
      "Ejecución de pruebas de calidad: aislamiento dieléctrico, verificación funcional y validación en entornos controlados",
      "Programación de PLCs Siemens SIMATIC y parametrización de variadores de frecuencia y arrancadores suaves para motores de hasta 300 HP",
      "Mantenimiento en campo en plantas de Ingenio Chaparrastique, CASSA, PUMA Energy y Kimberly-Clark",
      "Puesta en marcha de tableros en Alimentos Maravilla, Guatemala",
      "Seguimiento y gestión de proyectos de automatización a gran escala",
    ],
    techTags: [],
    icon: "⚡",
  },
  {
    period: "Ministerio de Cultura | Gobierno de El Salvador",
    role: "Técnico Especialista en Infraestructura y Ciberseguridad",
    company: "Ministerio de Cultura",
    location: "El Salvador",
    summary:
      "Diseño e implementación de arquitecturas de red seguras, desarrollo de aplicaciones internas bajo estándares ISO 27001 y operación de entornos de monitoreo SOC/NOC para la protección de activos digitales institucionales.",
    highlights: [
      "Desarrollo de aplicaciones escalables con Laravel y Vue.js, aplicando patrones de diseño, prácticas de ciberseguridad y diseño UI/UX",
      "Implementación de entornos de monitoreo SOC/NOC con Grafana, Zabbix, Wazuh y CrowdStrike Falcon",
      "Respuesta a incidentes de seguridad mediante consolas ESET Endpoint y CrowdStrike Falcon",
      "Configuración de enrutamiento dinámico BGP entre dependencias con SD-WAN para túneles seguros multi-proveedor",
      "Desarrollo de soluciones alineadas con la normativa ISO 27001",
      "Gestión de servidores y centros de datos on-premise sobre Linux Debian",
      "Configuración avanzada de soluciones de ciberseguridad de la marca Hillstone Networks y Fortinet tales como WAF, NIPS, NGFW y BDS para la detección de brechas de seguridad a nivel horizontal",
    ],
    techTags: [],
    icon: "🛡️",
  },
];
---

<section class="experience section" id="experience">
  <div class="container">
    <div class="section-header animate-on-scroll">
      <span class="section-label">Trayectoria Profesional</span>
      <h2 class="section-title">Experiencia</h2>
      <p class="section-description">
        De tableros industriales de alta potencia a arquitecturas de
        ciberseguridad
      </p>
    </div>

    <div class="experience-timeline">
      {
        experiences.map((exp, index) => (
          <div
            class={`experience-card animate-on-scroll animate-delay-${index + 1}`}
          >
            <div class="experience-marker">
              <span class="marker-icon">{exp.icon}</span>
              <div class="marker-line" />
            </div>
            <div class="experience-content">
              <div class="experience-header">
                <div class="experience-meta">
                  <span class="experience-company-badge">{exp.period}</span>
                  <span class="experience-location">📍 {exp.location}</span>
                </div>
                <h3 class="experience-role">{exp.role}</h3>
              </div>
              <p class="experience-summary">{exp.summary}</p>
              <ul class="experience-highlights">
                {exp.highlights.map((h) => (
                  <li class="highlight-item">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
              <div class="experience-tags">
                {exp.techTags.map((tag) => (
                  <span class="exp-tag">{tag}</span>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .experience {
    position: relative;
  }

  .experience-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    max-width: 920px;
    margin: 0 auto;
  }

  .experience-card {
    display: flex;
    gap: var(--space-xl);
  }

  .experience-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .marker-icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--sand);
    border-radius: var(--radius-md);
    font-size: 1.5rem;
    border: 2px solid var(--sand-dark);
    transition: all var(--transition-base);
    flex-shrink: 0;
  }

  .experience-card:hover .marker-icon {
    background: var(--terracotta);
    border-color: var(--terracotta);
    transform: scale(1.1);
    box-shadow: 0 4px 20px rgba(184, 92, 56, 0.3);
  }

  .marker-line {
    width: 2px;
    flex: 1;
    background: linear-gradient(to bottom, var(--sand-dark), transparent);
    margin-top: var(--space-sm);
  }

  .experience-content {
    background: white;
    border-radius: var(--radius-lg);
    padding: var(--space-xl) var(--space-2xl);
    border: 1px solid var(--sand-dark);
    transition: all var(--transition-base);
    flex: 1;
  }

  .experience-content:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--clay-light);
  }

  .experience-header {
    margin-bottom: var(--space-lg);
  }

  .experience-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
    flex-wrap: wrap;
  }

  .experience-company-badge {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: white;
    background: var(--terracotta);
    padding: 0.25rem 0.85rem;
    border-radius: var(--radius-full);
    letter-spacing: 0.02em;
  }

  .experience-location {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--stone-light);
  }

  .experience-role {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
  }

  .experience-summary {
    font-size: 0.95rem;
    color: var(--stone);
    line-height: 1.75;
    margin-bottom: var(--space-lg);
    max-width: 100%;
  }

  .experience-highlights {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: var(--space-xl);
  }

  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    font-size: 0.88rem;
    color: var(--stone);
    line-height: 1.55;
  }

  .highlight-item svg {
    color: var(--moss);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .experience-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .exp-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--stone);
    background: var(--sand);
    border: 1px solid var(--sand-dark);
    padding: 0.2rem 0.7rem;
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .exp-tag:hover {
    border-color: var(--clay);
    color: var(--ink);
  }

  @media (max-width: 768px) {
    .experience-card {
      gap: var(--space-md);
    }

    .marker-icon {
      width: 44px;
      height: 44px;
      font-size: 1.2rem;
    }

    .experience-content {
      padding: var(--space-lg);
    }

    .experience-role {
      font-size: 1.15rem;
    }
  }

  @media (max-width: 480px) {
    .experience-marker {
      display: none;
    }

    .experience-content {
      padding: var(--space-md);
    }

    .experience-role {
      font-size: 1.05rem;
    }
  }
</style>
