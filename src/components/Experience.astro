---
interface ExperienceItem {
  period: string;
  role: string;
  company: string;
  location: string;
  summary: string;
  highlights: string[];
  techTags: string[];
  icon: string;
}

const experiences: ExperienceItem[] = [
  {
    period: "Siemens El Salvador",
    role: "Técnico en Automatización Industrial",
    company: "Siemens",
    location: "El Salvador",
    summary:
      "Integración directa en líneas de producción y proyectos de automatización de alto impacto, ejecutando desde ensamblaje estructural hasta puesta en marcha en campo para clientes industriales de la región centroamericana.",
    highlights: [
      "Ensamblaje estructural y eléctrico de tableros de control y distribución de 2,000 a 5,000 A en baja tensión y transferencias de media tensión",
      "Ejecución de pruebas de calidad: aislamiento dieléctrico, verificación funcional y validación en entornos controlados",
      "Programación de PLCs Siemens SIMATIC y parametrización de variadores de frecuencia y arrancadores suaves para motores de hasta 300 HP",
      "Mantenimiento en campo en plantas de Ingenio Chaparrastique, CASSA, PUMA Energy y Kimberly-Clark",
      "Puesta en marcha de tableros en Alimentos Maravilla, Guatemala",
      "Seguimiento y gestión de proyectos de automatización a gran escala",
    ],
    techTags: [
      "PLC SIMATIC",
      "TIA Portal",
      "Automatización industrial",
      "Media y baja tensión",
      "Variadores de frecuencia",
    ],
    icon: "⚡",
  },
  {
    period: "Ministerio de Cultura | Gobierno de El Salvador",
    role: "Especialista en Ciberseguridad y Desarrollo de Aplicaciones",
    company: "Ministerio de Cultura",
    location: "El Salvador",
    summary:
      "Responsable de la seguridad y la infraestructura tecnológica de la institución: arquitecturas de red seguras, monitoreo continuo y desarrollo de aplicaciones internas para la protección de los activos digitales del Ministerio.",
    highlights: [
      "Administración de la infraestructura de servidores institucionales: físicos y virtualizados en VMware e Hyper-V, centros de datos locales sobre Linux Debian y nube de Google Cloud",
      "Configuración y mantenimiento de equipos de seguridad avanzada de Hillstone Networks y Fortinet —NGFW, WAF, NIPS, BDS, XDR y EDR— para la detección de brechas a nivel horizontal y vertical",
      "Operación del monitoreo SOC/NOC con Grafana, Zabbix, Wazuh, CrowdStrike Falcon y ESET Endpoint Security, centralizando el análisis masivo de logs de todas las dependencias y la respuesta a incidentes",
      "Enrutamiento dinámico BGP entre dependencias con SD-WAN para túneles seguros multi-proveedor",
      "Auditor interno certificado en ISO/IEC 27001:2022 e implementación del SGSI para la protección de datos de los empleados de la institución",
      "Desarrollo de aplicaciones web escalables en Laravel y Vue.js con despliegue automatizado, integradas mediante API REST, WebSocket y microservicios, aplicando patrones de diseño, prácticas de seguridad y UI/UX",
      "Lideré la evolución del centro de datos, migrando de una infraestructura Tier I a estándares de diseño Tier III",
    ],
    techTags: [
      "ISO/IEC 27001:2022",
      "SOC / NOC",
      "Wazuh",
      "CrowdStrike Falcon",
      "NGFW / WAF / IPS",
      "XDR / EDR",
      "Fortinet",
      "Hillstone Networks",
      "Google Cloud",
      "VMware / Hyper-V",
      "Linux Debian",
      "BGP / SD-WAN",
      "Laravel",
      "Vue.js",
    ],
    icon: "🛡️",
  },
];
---

<section class="experience section" id="experience">
  <div class="container">
    <div class="section-header animate-on-scroll">
      <span class="section-label">Trayectoria Profesional</span>
      <h2 class="section-title">Experiencia</h2>
      <p class="section-description">
        De tableros industriales de alta potencia a arquitecturas de
        ciberseguridad
      </p>
    </div>

    <div class="experience-timeline">
      {
        experiences.map((exp, index) => (
          <div
            class={`experience-card animate-on-scroll animate-delay-${index + 1}`}
          >
            <div class="experience-marker">
              <span class="marker-icon">{exp.icon}</span>
              <div class="marker-line" />
            </div>
            <div class="experience-content">
              <div class="experience-header">
                <div class="experience-meta">
                  <span class="experience-company-badge">{exp.period}</span>
                  <span class="experience-location">📍 {exp.location}</span>
                </div>
                <h3 class="experience-role">{exp.role}</h3>
              </div>
              <p class="experience-summary">{exp.summary}</p>
              <ul class="experience-highlights">
                {exp.highlights.map((h) => (
                  <li class="highlight-item">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
              <div class="experience-tags">
                {exp.techTags.map((tag) => (
                  <span class="exp-tag">{tag}</span>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .experience {
    position: relative;
  }

  .experience-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    max-width: 920px;
    margin: 0 auto;
  }

  .experience-card {
    display: flex;
    gap: var(--space-xl);
  }

  .experience-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .marker-icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--sand);
    border-radius: var(--radius-md);
    font-size: 1.5rem;
    border: 2px solid var(--sand-dark);
    transition: all var(--transition-base);
    flex-shrink: 0;
  }

  .experience-card:hover .marker-icon {
    background: var(--terracotta);
    border-color: var(--terracotta);
    transform: scale(1.1);
    box-shadow: 0 4px 20px rgba(184, 92, 56, 0.3);
  }

  .marker-line {
    width: 2px;
    flex: 1;
    background: linear-gradient(to bottom, var(--sand-dark), transparent);
    margin-top: var(--space-sm);
  }

  .experience-content {
    background: white;
    border-radius: var(--radius-lg);
    padding: var(--space-xl) var(--space-2xl);
    border: 1px solid var(--sand-dark);
    transition: all var(--transition-base);
    flex: 1;
  }

  .experience-content:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--clay-light);
  }

  .experience-header {
    margin-bottom: var(--space-lg);
  }

  .experience-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
    flex-wrap: wrap;
  }

  .experience-company-badge {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: white;
    background: var(--terracotta);
    padding: 0.25rem 0.85rem;
    border-radius: var(--radius-full);
    letter-spacing: 0.02em;
  }

  .experience-location {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--stone-light);
  }

  .experience-role {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
  }

  .experience-summary {
    font-size: 0.95rem;
    color: var(--stone);
    line-height: 1.75;
    margin-bottom: var(--space-lg);
    max-width: 100%;
  }

  .experience-highlights {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: var(--space-xl);
  }

  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    font-size: 0.88rem;
    color: var(--stone);
    line-height: 1.55;
  }

  .highlight-item svg {
    color: var(--moss);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .experience-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .exp-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--stone);
    background: var(--sand);
    border: 1px solid var(--sand-dark);
    padding: 0.2rem 0.7rem;
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .exp-tag:hover {
    border-color: var(--clay);
    color: var(--ink);
  }

  @media (max-width: 768px) {
    .experience-card {
      gap: var(--space-md);
    }

    .marker-icon {
      width: 44px;
      height: 44px;
      font-size: 1.2rem;
    }

    .experience-content {
      padding: var(--space-lg);
    }

    .experience-role {
      font-size: 1.15rem;
    }
  }

  @media (max-width: 480px) {
    .experience-marker {
      display: none;
    }

    .experience-content {
      padding: var(--space-md);
    }

    .experience-role {
      font-size: 1.05rem;
    }
  }
</style>
