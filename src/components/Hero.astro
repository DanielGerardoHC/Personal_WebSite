---
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
---

<section class="hero" id="hero">
  <div class="hero-bg">
    <!-- Organic decorative shapes -->
    <svg class="hero-blob blob-1" viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg">
      <path d="M305.3,373.7Q253.4,447.4,168.1,427.8Q82.8,408.2,59.5,304.1Q36.2,200,128.3,141.2Q220.4,82.4,310.2,91.2Q400,100,415.8,200Q431.6,300,305.3,373.7Z" fill="var(--sand)"/>
    </svg>
    <svg class="hero-blob blob-2" viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg">
      <path d="M379.5,340.4Q322.8,380.8,268.2,397.5Q213.6,414.2,162.3,377.1Q111,340,99.5,270Q88,200,140.8,155.3Q193.6,110.6,264.8,83.3Q336,56,390.5,128Q445,200,379.5,340.4Z" fill="var(--sand-dark)" opacity="0.5"/>
    </svg>
    <div class="hero-grain"></div>
  </div>

  <div class="hero-content container">
    <div class="hero-text">
      <div class="hero-greeting animate-on-scroll">
        <span class="greeting-line"></span>
        <span class="greeting-text">Hola, soy</span>
      </div>
      <h1 class="hero-name animate-on-scroll animate-delay-1">
        Daniel<br/>
        <span class="name-accent">Hernandez</span>
      </h1>
      <div class="hero-role animate-on-scroll animate-delay-2">
        <span class="role-tag">Senior Cybersecurity Engineer — Full Stack Developer</span>
        <span class="cursor">|</span>
      </div>
      <p class="hero-desc animate-on-scroll animate-delay-3">
        Auditor Interno certificado en ISO/IEC 27001:2022. Protejo infraestructura crítica en centros de datos y entornos cloud, y construyo software seguro desde el diseño.
      </p>
      <div class="hero-actions animate-on-scroll animate-delay-4">
        <a href="#projects" class="btn btn-primary">
          Ver Proyectos
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </a>
      </div>
    </div>

    <div class="hero-visual animate-on-scroll animate-delay-2">
      <div class="photo-frame">
        <img src={`${base}/images/img_me.png`} alt="Daniel Hernandez — Senior Cybersecurity Engineer y Full Stack Developer" class="hero-photo" loading="eager" />
      </div>
    </div>
  </div>

  <div class="hero-scroll-hint">
    <span class="scroll-text">Scroll</span>
    <div class="scroll-line">
      <div class="scroll-dot"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: var(--nav-height);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-blob {
    position: absolute;
    opacity: 0.7;
  }

  .blob-1 {
    width: 500px;
    top: -10%;
    right: -8%;
    animation: float 8s ease-in-out infinite;
  }

  .blob-2 {
    width: 400px;
    bottom: -5%;
    left: -5%;
    animation: float 10s ease-in-out infinite reverse;
  }

  .hero-grain {
    position: absolute;
    inset: 0;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 200px;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3xl);
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hero-greeting {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .greeting-line {
    display: block;
    width: 40px;
    height: 2px;
    background: var(--terracotta);
  }

  .greeting-text {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--terracotta);
    letter-spacing: 0.05em;
  }

  .hero-name {
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 1.05;
    margin-bottom: var(--space-lg);
    letter-spacing: -0.03em;
  }

  .name-accent {
    color: var(--terracotta);
    position: relative;
  }

  .hero-role {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .role-tag {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    color: var(--stone);
    padding: 0.4rem 1rem;
    background: var(--sand);
    border-radius: var(--radius-full);
    border: 1px solid var(--sand-dark);
  }

  .cursor {
    font-weight: 300;
    color: var(--terracotta);
    animation: blink 1s infinite;
  }

  .hero-desc {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--stone);
    margin-bottom: var(--space-xl);
    max-width: 42ch;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  /* --- Photo --- */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .photo-frame {
    position: relative;
    width: 380px;
    max-width: 100%;
  }

  .hero-photo {
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 0;
    border: none;
    filter: drop-shadow(0 20px 40px rgba(26, 26, 26, 0.18));
    position: relative;
    z-index: 2;
    transition: transform var(--transition-base);
  }

  .hero-photo:hover {
    transform: scale(1.03);
  }





  /* --- Scroll Hint --- */
  .hero-scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .scroll-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--stone-light);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .scroll-line {
    width: 1px;
    height: 40px;
    background: var(--sand-dark);
    position: relative;
    overflow: hidden;
  }

  .scroll-dot {
    width: 3px;
    height: 10px;
    background: var(--terracotta);
    border-radius: var(--radius-full);
    position: absolute;
    left: -1px;
    animation: scrollDown 2s ease-in-out infinite;
  }

  @keyframes scrollDown {
    0% { top: 0; opacity: 0; }
    30% { opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }

  /* --- Responsive --- */
  @media (max-width: 968px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--space-2xl);
    }

    .hero-text {
      order: 2;
    }

    .hero-visual {
      order: 1;
    }

    .hero-greeting {
      justify-content: center;
    }

    .hero-desc {
      margin: 0 auto var(--space-xl);
    }

    .hero-actions {
      justify-content: center;
    }

    .photo-frame {
      width: 280px;
    }

    .floating-badge {
      display: none;
    }

    .hero-scroll-hint {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero-name {
      font-size: 2.5rem;
    }

    .photo-frame {
      width: 220px;
    }
  }
</style>
